# Hangi saglayici kullanilacak: google | anthropic
LLM_PROVIDER=google

# Google AI Studio (ucretsiz katman): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic (opsiyonel, demo/teslim asamasi icin)
ANTHROPIC_API_KEY=

# Model secimi - bos birakilirsa saglayiciya gore varsayilan atanir.
# Hesabinda hangilerinin acik oldugunu gormek icin: python scripts/check_models.py
LLM_MODEL=
EMBEDDING_MODEL=
